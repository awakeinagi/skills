     "type": "text"
    }
   ],
   "customData": {
    "author": "agent",
    "kind": "kpi",
    "role": "node",
    "tooltip": "The one KPI with no unit and no scale. 62 out of what, and is 62 good?\n\nIt is also the only tile that dies quietly: if the news stream missed the Cutoff this is computed from Last-Good, and nothing here says so.",
    "value": "62"
   },
