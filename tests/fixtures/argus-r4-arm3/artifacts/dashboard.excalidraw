    {
     "id": "reader-meta-label",
     "type": "text"
    }
   ],
   "customData": {
    "author": "agent",
    "kind": "block",
    "parent": "reader-panel",
    "role": "node",
    "tooltip": "My invention. A published report is frozen, so it is the one place in the product where 'which run made this' can be stated permanently and truthfully.\n\nIf this line does not exist today, a reader has no way to know whether what they are reading came from a degraded morning."
   },
