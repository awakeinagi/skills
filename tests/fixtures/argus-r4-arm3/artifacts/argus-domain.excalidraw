   ],
   "customData": {
    "author": "agent",
    "kind": "entity",
    "role": "node",
    "tooltip": "The settings snapshot is why a rerun can be compared to an original instead of replacing it.\n\n**A Rerun is a PipelineRun** that points at the one it re-ran — a self-relationship, not a separate entity. That is what finally makes 'the dashboard follows the newest run' answerable: newest *within a lineage*.\n\n**Known over-claim:** after a partial rerun the snapshot describes the whole day when it only describes a quarter of it. An accident of how it was built, not a design.\n\n**stale sources** is run-level, which is today's answer and not the wanted one."
   },
   "fillStyle": "solid",
   "frameId": null,
   "groupIds": [
    "pipeline-run-grp"
   ],
   "height": 100,
   "id": "pipeline-run",
   "isDeleted": false,
   "link": null,
   "locked": false,
   "opacity": 100,
   "roughness": 1,
   "roundness": null,
   "seed": 328371889,
