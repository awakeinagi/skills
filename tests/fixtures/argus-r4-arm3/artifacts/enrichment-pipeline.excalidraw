   ],
   "customData": {
    "author": "agent",
    "kind": "source",
    "role": "node",
    "tooltip": "**Three of the four scorers read this**, each for something different: filing tone, line items, Form 4s.\n\nWhich means that after the news cut, EDGAR is by a wide margin the largest shared input left on this diagram — and shared inputs are what make signals move together."
   },
   "fillStyle": "solid",
   "frameId": null,
   "groupIds": [],
   "height": 64,
   "id": "src-edgar",
   "isDeleted": false,
