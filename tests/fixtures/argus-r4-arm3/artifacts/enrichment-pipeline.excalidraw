   "customData": {
    "author": "agent",
    "kind": "agent",
    "role": "node",
    "tooltip": "Drawn as an **agent** node, not a transform, because judging tone is not deterministic work.\n\nThat is a claim, and it is the one that makes the confidence threshold matter. If this is really a lexicon or a fixed classifier, tell me and I will demote it."
   },
