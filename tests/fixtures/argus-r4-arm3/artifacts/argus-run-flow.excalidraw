   ],
   "customData": {
    "author": "agent",
    "kind": "sink",
    "role": "node",
    "tooltip": "All three exist all the time, on their own clocks:\n\n- **Signals Digest** — daily\n- **Weekly Brief** — Monday morning\n- **Risk Deep-Dive** — first business day of the month\n\nThe run refreshes the data. The calendar decides what gets published."
   },
   "fillStyle": "solid",
   "frameId": null,
   "groupIds": [],
   "height": 64,
