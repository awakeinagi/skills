   "customData": {
    "author": "agent",
    "kind": "control",
    "role": "node",
    "tooltip": "The confidence gate. Below 0.70 a signal does not vanish — it goes to the review queue and waits for a person.\n\nSet from the console. Dragging it down publishes signals that were previously invisible; dragging it up does not silence them, it makes more work for whoever clears the queue."
   },
   "fillStyle": "solid",
   "frameId": null,
   "groupIds": [],
   "height": 80,
