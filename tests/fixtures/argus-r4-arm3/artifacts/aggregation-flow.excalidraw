   ],
   "customData": {
    "author": "agent",
    "kind": "transform",
    "role": "node",
    "tooltip": "**A black box, and the oldest one in the project.** Your first description was 'everything gets weighed into a risk model and an aggregator' — this is the weighing, and nobody has ever said how it works.\n\nFour scorers can all fire on one name. Something turns four numbers into one view of that instrument, and whatever it is decides what the whole product says."
   },
   "fillStyle": "solid",
   "frameId": null,
   "groupIds": [],
