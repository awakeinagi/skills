   ],
   "customData": {
    "author": "agent",
    "kind": "transform",
    "role": "node",
    "tooltip": "**Mine, shaded so you can delete it.** This is your 'watch out for crowded trades' note, drawn as the smallest thing that could satisfy it.\n\nIt sits here because this is the only place it can sit: after signals are combined per name, before that combination is turned into risk. Anywhere earlier and there is nothing to discount; anywhere later and the risk numbers are already wrong."
   },
