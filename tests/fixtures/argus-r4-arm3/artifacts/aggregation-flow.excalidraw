   ],
   "customData": {
    "author": "agent",
    "kind": "store",
    "role": "node",
    "tooltip": "**Not a dead end after all.** Low-confidence signals sit here and somebody looks at them; approved ones rejoin the pipeline.\n\nAnd this queue reaches forward: no unreviewed signal in it may reach a client, so a full queue blocks publication. Click through to see that gate.\n\nStill true, and still unreported anywhere: nothing tells an analyst how many signals landed here today."
   },
