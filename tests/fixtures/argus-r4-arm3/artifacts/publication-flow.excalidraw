   "customData": {
    "author": "agent",
    "kind": "control",
    "role": "node",
    "tooltip": "The run refreshes the data; the calendar decides what goes out.\n\n- **Signals Digest** — daily\n- **Weekly Brief** — Monday morning\n- **Risk Deep-Dive** — first business day of the month"
   },
