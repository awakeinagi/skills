   "customData": {
    "author": "agent",
    "kind": "store",
    "role": "node",
    "tooltip": "Once out, out. A rerun never reissues one.\n\nWhich has a consequence worth staring at: a signal approved *after* a report published has nowhere to go. The report that should have carried it is already frozen."
   },
