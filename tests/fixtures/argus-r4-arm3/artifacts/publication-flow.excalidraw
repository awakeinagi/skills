   ],
   "customData": {
    "author": "agent",
    "kind": "control",
    "role": "node",
    "tooltip": "**Non-negotiable:** no unreviewed low-confidence signal ever reaches a client.\n\nThis is the first gate in Argus that a *person* has to clear, and the first thing in the system that can stop a report going out."
   },
   "fillStyle": "solid",
   "frameId": null,
   "groupIds": [],
   "height": 80,
   "id": "review-gate",
   "isDeleted": false,
