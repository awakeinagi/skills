    {
     "id": "held-label",
     "type": "text"
    }
   ],
   "customData": {
    "author": "agent",
    "kind": "control",
    "role": "node",
    "tooltip": "The blocked state. Nothing publishes while the queue has unreviewed items in it.\n\n**This is new behaviour for Argus.** Every other deadline in this system resolves by shipping something degraded — stale data, missing sentiment, a four-of-five run. This one resolves by not shipping at all, and it waits on a human being."
   },
   "fillStyle": "solid",
   "frameId": null,
   "groupIds": [],
   "height": 64,
   "id": "held",
   "isDeleted": false,
