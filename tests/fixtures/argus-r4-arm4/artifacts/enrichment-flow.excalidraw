   "customData": {
    "author": "agent",
    "document": "docs/adr/0003-the-review-queue-blocks-publication.md",
    "kind": "sink",
    "role": "node",
    "tooltip": "**Everything leaves here now.** This used to be where the 0.70 gate dropped low-confidence Signals silently. It doesn't any more — the gate moved to its own view and became a router (ADR 0003).\n\nWhat leaves this box is every scored Signal, high and low. What happens to the low ones is a decision, and a human makes it."
   },
