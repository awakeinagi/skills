   "customData": {
    "author": "agent",
    "kind": "kpi",
    "role": "node",
    "tooltip": "First-of-month cut. August 1st was a Saturday and there is no weekend run — so the monthly cut rode the same Monday run as the weekly one, and both cards show the same date.\n\nDrawn that way on purpose. If 'first of month' means something else when the 1st is a weekend, correct the value.",
    "value": "Mon 3 Aug"
