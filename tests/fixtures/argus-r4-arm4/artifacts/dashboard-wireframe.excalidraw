   ],
   "customData": {
    "author": "agent",
    "kind": "kpi",
    "role": "node",
    "tooltip": "**The one thing here that isn't as-is.** Doesn't exist on the real screen; you said keep it.\n\nIt reads 4/5, not 4/4 — because the macro calendar is off by choice, not absent by accident, and a tile that can't tell those apart is not worth having. That distinction is most of this tile's job.",
    "value": "4/5"
   },
