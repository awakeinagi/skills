   "customData": {
    "author": "agent",
    "kind": "kpi",
    "role": "node",
    "tooltip": "The one KPI that is genuinely a pipeline output — it comes off the risk model.\n\nWorth staring at: your alert threshold is **2.5%** and the screen is showing **2.4%**. The headline number on the morning dashboard is sitting a tenth of a point under the alarm.",
    "value": "2.4%"
   },
