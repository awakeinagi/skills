   ],
   "customData": {
    "author": "agent",
    "document": "docs/adr/0003-the-review-queue-blocks-publication.md",
    "kind": "input",
    "parent": "panel-thresholds",
    "role": "node",
    "tooltip": "**A router, not a gate.** Below 0.70 a Signal goes to the Review queue, and a non-empty queue blocks publication (ADR 0003). Nothing is discarded.\n\nWhich makes this the most consequential field on the screen, in a way it wasn't before: **lowering it enlarges somebody's morning.** More signals fall below the line, more land in the queue, and every one of them has to be vetted before anything ships. The console shows the number and says nothing about the workload it creates.",
    "value": "0.70"
   },
   "fillStyle": "solid",
   "frameId": "screen-admin",
   "groupIds": [
