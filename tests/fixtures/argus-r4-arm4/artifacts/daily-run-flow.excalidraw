   "customData": {
    "author": "agent",
    "kind": "transform",
    "role": "node",
    "tooltip": "**Per source, not into one pool.** The old label let this box read as a merge point, and the routing correction says it isn't one: each source keeps its identity through normalization and is delivered to specific enrichers.\n\nEDGAR → sentiment scorer, insider detector (and probably fundamentals). News → sentiment scorer only. Market feed → technicals only. Portfolio DB scopes the run to our names and feeds no scorer.\n\nFive sources configured, four on."
   },
   "fillStyle": "solid",
