   "customData": {
    "author": "agent",
    "kind": "transform",
    "role": "node",
    "tooltip": "**Click through to `enrichment-flow`.** Four enrichers in parallel, and they do not converge on one place: sentiment + fundamentals feed the risk model; technicals + insider clusters go straight to the aggregator; the risk model's output joins them there.\n\nCollapsed to one box *here* because that topology cannot share a canvas with the ingest fan and stay readable."
   },
   "fillStyle": "solid",
