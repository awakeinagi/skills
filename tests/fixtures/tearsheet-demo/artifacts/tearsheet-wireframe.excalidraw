   "customData": {
    "answer": null,
    "question": "I put agent-written prose above every number. Reasoning: at 07:35 on a phone the first screenful IS the product, so it should be synthesis, not a market recap people can get anywhere. The cost: the first thing your PMs read every single morning is model-written text, unreviewed. Is that the right thing above the fold, or do you want hard numbers first and prose further down where it can do less damage?",
    "role": "pin",
    "status": "open",
    "target": "blk-top-of-sheet"
   },
