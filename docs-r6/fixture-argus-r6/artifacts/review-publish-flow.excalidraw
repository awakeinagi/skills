   "customData": {
    "author": "agent",
    "kind": "store",
    "role": "node",
    "tooltip": "Sub-threshold Signals wait here. This is the first piece of **state that survives a run** anywhere in the design — everything else in Argus wakes at 06:00 and keeps nothing.\n\nWhich raises a question nobody has asked yet: does the queue empty at the end of the day, or can something sit in it for a week?"
   },
   "fillStyle": "solid",
